# Which Angular configuration is compiled into the image:
#   production -> src/environments/environment.prod.ts (the address of the deployed API)
#   local      -> src/environments/environment.ts      (localhost, for trying the image on your machine)
APP_ENV=production

# Host port published for the backoffice container (the container always listens on 80).
BACKOFFICE_PORT=4200

# Image tag produced by `docker compose build`.
BACKOFFICE_IMAGE=backoffice:latest
