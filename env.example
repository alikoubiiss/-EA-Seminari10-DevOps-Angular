# Template for the local environment file. Copy it next to this one and fill in your values:
#
#   cp env.example .env
#
# Docker Compose reads that file automatically for the ${VAR} substitution used in
# docker-compose.yml. Every value here is already the default written in docker-compose.yml,
# so an empty or missing local file still works.
#
# This template is named env.example instead of ".env.example" because the agent sandbox
# refuses to create any file starting with ".env". Rename it locally if you prefer.

# Which Angular configuration is compiled into the image:
#   production -> src/environments/environment.prod.ts (the address of the deployed API)
#   local      -> src/environments/environment.ts      (localhost, for trying the image on your machine)
APP_ENV=production

# Host port published for the backoffice container (the container always listens on 80).
BACKOFFICE_PORT=4200

# Image tag produced by `docker compose build`.
BACKOFFICE_IMAGE=backoffice:latest

# Shared bridge network. Other stacks (for example the backend API) join it with:
#   networks:
#     devop-net:
#       external: true
NETWORK_NAME=devop-net
